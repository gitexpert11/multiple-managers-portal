# SQLAlchemy URL. The default keeps a SQLite file under ./data/.
ADS_DATABASE_URL=sqlite:///./data/ads.db
# Comma-separated list of origins allowed to call the API (the Vite dev server by default).
ADS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Seed the product catalogue and create tables at startup.
ADS_AUTO_MIGRATE=true
